# Required. Choose a long, unique password before starting the app.
APP_PASSWORD=change-this-password

# Optional. Images are sent to this endpoint during extraction.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini
# LLM_API_KEY=

# Optional storage location. Keep this directory private and backed up.
DATA_DIR=./data

# Set to true when HTTPS is terminated by a trusted reverse proxy.
COOKIE_SECURE=false
